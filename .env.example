# ==========================================
# M.R GENERATORS - SMTP & EMAIL CONFIGURATION
# ==========================================

# SMTP Server Host (e.g. smtp.gmail.com, smtppro.zoho.in, mail.mrgenerators.com)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port:
# - 465 for SSL (set SMTP_SECURE=true)
# - 587 for STARTTLS (set SMTP_SECURE=false)
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication Credentials
# Note: For Gmail, use a 16-character App Password (Security -> 2-Step Verification -> App Passwords)
SMTP_USER=info@mrgenerators.com
SMTP_PASS=your-app-specific-password

# Email Dispatch Addresses
# From address displayed to the recipient
MAIL_FROM="M.R Generators Dispatch" <info@mrgenerators.com>

# Target email(s) that receive new quote and contact inquiries (comma separated)
MAIL_TO=info@mrgenerators.com, sales@mrgenerators.com
